# Base URL of the Loan Workflow backend API.
# Copy this file to `.env` for local dev (already git-ignored).
#
# Local dev (default if unset): the Spring Boot backend on your machine.
VITE_API_BASE=http://localhost:8080
#
# Production (Vercel): set this to the deployed backend URL, e.g.
# VITE_API_BASE=https://your-backend.up.railway.app
